{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",

    // Relative to this file, with no `baseUrl` — the form TypeScript 7 accepts.
    // The shared base deliberately has no `paths`: an `@/` import inside a
    // package would silently resolve against whichever app compiled it.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
