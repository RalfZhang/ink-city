{
  "name": "ink-city",
  "private": true,
  "version": "0.13.0",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "pnpm -F @inkcity/desktop dev",
    "build": "tsc -p packages/core && tsc -p packages/osm && tsc -p packages/ui && pnpm -F @inkcity/desktop build",
    "tauri": "pnpm -F @inkcity/desktop tauri",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "build:cities": "node scripts/build-cities.mjs",
    "precache": "tsx scripts/osm-cli.ts precache",
    "build:sidecar": "tsx scripts/build-sidecar.ts",
    "clean": "tsx scripts/clean.ts",
    "prepare": "tsx scripts/clean.ts --setup-git",
    "icon:car": "bash scripts/build-icon-car.sh",
    "render": "tsx scripts/render.ts",
    "road:render": "tsx scripts/render.ts road-test/json -o road-test/png -t png -s 8000x8000 --theme light -p all --no-stamp --rail plain",
    "road:fetch": "tsx scripts/render.ts --fetch-only -o road-test/json",
    "schedule-test": "tsx scripts/schedule-test.ts",
    "coords-test": "tsx scripts/coords-test.ts",
    "guess-test": "tsx scripts/guess-test.ts",
    "railway-test": "tsx scripts/railway-test.ts",
    "bbox-test": "tsx scripts/bbox-test.ts"
  },
  "devDependencies": {
    "@inkcity/core": "workspace:*",
    "@inkcity/osm": "workspace:*",
    "@types/node": "^26.1.1",
    "canvas": "^3.1.0",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3"
  }
}
