{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the settings window and the hidden renderer window",
  "windows": ["main", "renderer"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-url",
    "autostart:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
