<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Agent app: no Dock icon and no menu bar, ever. Applies to every launched
       process (including the transient second instance that single-instance
       forwards-then-exits), so no Dock icon flashes on re-open. The runtime
       set_activation_policy(Accessory) in lib.rs stays as a belt-and-suspenders
       fallback and to cover `tauri dev`, which runs the bare binary and does not
       go through this bundled Info.plist. -->
  <key>LSUIElement</key>
  <true/>
</dict>
</plist>
