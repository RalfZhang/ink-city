{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the settings window and the hidden renderer window",
  "windows": ["main", "renderer"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "autostart:default",
    "log:default"
  ]
